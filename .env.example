# Apify — Google Maps lead scraping (only needed for /apify-scrape pipeline)
# Get your token at: apify.com → Settings → Integrations
APIFY_TOKEN=

# Cloudflare Pages — site deployment
# Get at: dash.cloudflare.com → My Profile → API Tokens → Create Token → "Edit Cloudflare Pages"
CLOUDFLARE_API_TOKEN=
# Get at: dash.cloudflare.com — shown in the right sidebar of any zone page
CLOUDFLARE_ACCOUNT_ID=

# Agency domain — used in the sticky CTA banner on generated sites (optional)
# Example: rebuildagency.co.uk
AGENCY_DOMAIN=
